src/props/owl.js  (pure Canvas2D, no three.js import)
  drawOwlEmblem(ctx, cx, topY, owlH, { mode:'color'|'height'|'mask', palette: PALETTES.gold|bronze|marble, text:bool|string, wreath:bool, sprig:bool })
      owl (tetradrachm style) + laurel wreath (+ ΑΘΗΝΑ). Emblem ≈ 0.96·owlH wide, 1.42·owlH tall (1.85·owlH with text).
  drawOwl(ctx, opts)               owl alone in owl units (head top y=0, toes y≈1; set your own transform)
  drawLaurelWreath(ctx, opts)      open laurel wreath ({cx, cy, r, squash, gap, pairs, leafLen, leafW})
  drawGreekText(ctx, 'ΑΘΗΝΑ', cx, baselineY, capHeight, { mode, palette })   procedural serif capitals (Α Θ Η Ν)
  makeOwlEmblemCanvas(sizePx, { mode, palette, text, background })            → OffscreenCanvas
  'height' mode = relief (raised bright, engraved lines dark) → good for shield/coin normal maps.

